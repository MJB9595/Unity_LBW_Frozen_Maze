# ==========================================
# 1. 유니티 필수 제외 폴더 (용량의 90%를 차지하는 주범)
# ==========================================
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/

# 메모리 캡처 파일
*.mem

# ==========================================
# 2. 에디터 및 IDE 자동 생성 파일 제외
# ==========================================
