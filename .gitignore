# ============================================ #
#   Unity 3D HDRP Project - .gitignore         #
#   Based on: github/gitignore/Unity.gitignore #
# ============================================ #

# --- Unity Engine generated folders ---
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# --- macOS specific files ---
# These cause errors on Windows/Linux when pulled from git
.DS_Store
**/.DS_Store
.AppleDouble
.LSOverride
._*

# --- Windows specific files ---
Thumbs.db
Thumbs.db.meta
ehthumbs.db
ehthumbs.db.meta
Desktop.ini

# --- Linux specific files ---
*~
.directory

# --- Unity Asset meta files ---
# Meta files should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta
!/[Pp]ackages/**/*.meta

# --- Visual Studio / Rider cache directories ---
.vs/
.idea/
.vscode/settings.json
.vscode/launch.json
.vscode/tasks.json
*.DotSettings.user

# --- Gradle cache (Android builds) ---
.gradle/

# --- Auto-generated solution/project files ---
# Unity regenerates these on each machine.
# Keep them ignored so they don't cause conflicts between Mac/Windows.
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.genmod

# --- Unity3D generated meta files for temp files ---
*.pidb.meta
*.pdb.meta
*.mdb.meta

# --- Unity crash reports ---
sysinfo.txt
mono_crash.*.json

# --- Build artifacts ---
*.apk
*.aab
*.unitypackage
*.app
*.xcodeproj
*.xcworkspace

# --- Asset Store / Third-party tools ---
[Aa]ssets/AssetStoreTools*
[Aa]ssets/Plugins/Editor/JetBrains*

# --- Exported assets / misc ---
ExportedObj/
.consulo/
*.booproj

# --- Crashlytics ---
crashlytics-build.properties

# --- Generated Assets (AI-generated, temp) ---
GeneratedAssets/

# --- Temporary / backup files ---
*.bak
*.orig
*.swo
*.swp
tmp/
